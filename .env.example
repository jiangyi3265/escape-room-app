# 复制为 .env.local 后按需填写（.env.local 不会提交到仓库）

# 门店后端地址。
# - H5：留空即可，开发时走 /store-api 代理；正式部署时由 nginx 把 /store-api 转发到后端。
# - 微信小程序：必须填写已备案并加入「request 合法域名」的 https 地址，例如 https://api.example.com
VITE_API_BASE_URL=

# H5 开发服务器端口与代理目标（只在 npm run dev:h5 时使用）
VITE_DEV_PORT=5260
VITE_DEV_API_TARGET=http://127.0.0.1:8087

# 在微信公众平台选择订阅消息模板后，填写模板 ID；多个模板用英文逗号分隔。
# 模板字段需包含：thing1（消息标题）、thing2（消息内容）、time3（发生时间）。
VITE_WECHAT_SUBSCRIBE_TEMPLATE_IDS=
