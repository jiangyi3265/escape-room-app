{
  "name": "escape-room-store-miniapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:navigation": "node scripts/test-navigation-layout.mjs",
    "test:order-visibility": "node scripts/test-order-visibility.mjs",
    "test:payments": "node scripts/test-payments.mjs",
    "test:store-config": "node scripts/test-store-config.mjs",
    "test:redlines": "node scripts/test-redline-requirements.mjs",
    "test:style": "node scripts/test-style-unchanged.mjs",
    "test": "npm run test:navigation && npm run test:order-visibility && npm run test:payments && npm run test:store-config && npm run test:redlines && npm run test:style",
    "test:live": "node scripts/test-live-flows.mjs",
    "test:h5": "node scripts/test-h5-e2e.mjs",
    "dev:h5": "cross-env UNI_INPUT_DIR=. uni",
    "build:h5": "cross-env UNI_INPUT_DIR=. uni build",
    "dev:mp-weixin": "cross-env UNI_INPUT_DIR=. uni -p mp-weixin",
    "build:mp-weixin": "node scripts/check-miniapp-release.mjs && cross-env UNI_INPUT_DIR=. uni build -p mp-weixin && node scripts/prepare-miniapp-project.mjs",
    "visual:check": "python scripts/compare_visuals.py"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "^3.4.21",
    "vue-i18n": "^9.1.9"
  },
  "devDependencies": {
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "@vue/runtime-core": "^3.4.21",
    "cross-env": "^10.0.0",
    "rollup": "4.14.3",
    "vite": "5.2.8"
  }
}
